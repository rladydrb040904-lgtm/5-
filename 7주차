// 바닥

let groundX = 0, groundY = 250, groundW = 1000, groundH = 150;

let groundR = 50, groundG = 205, groundB = 50;



// 태양

let sunX = 0, sunY = 70, sunSize = 40, sunVelocity = -1;



// 바위

let rockX = 300, rockY = 250, rockSize = 80;



// 쥐

let ratX = 0, ratY = 300, ratSpeed = 1;



// 나무 배열

let treeX = [];

let treeY = [];

let treeType = []; // 0: 기본, 1: 거리 비례색, 2: 마우스 호버색



// 열매 배열

let fruitX = [];

let fruitY = [];

let fruitD = [];



// 별똥별(가속) 배열

let ssX = [];

let ssY = [];

let ssSpeedX = [];

let ssSpeedY = [];

let ssAccelX = [];

let ssAccelY = [];



// 별똥별(마찰) 배열

let fsX = [];

let fsY = [];

let fsSpeedX = [];

let fsSpeedY = [];

let fsFriction = [];



// 날파리

let flyX = 0;

let flyTheta = 0;



// 사람 X좌표

let personX = 0; 



function setup() {

  createCanvas(1000, 400);



  // 나무 초기화

  treeX[0] = 50;  treeY[0] = 130; treeType[0] = 0;

  treeX[1] = 250; treeY[1] = 130; treeType[1] = 0;

  treeX[2] = 450; treeY[2] = 130; treeType[2] = 1;

  treeX[3] = 650; treeY[3] = 130; treeType[3] = 0;

  treeX[4] = 850; treeY[4] = 130; treeType[4] = 2;



  // 열매 초기화

  fruitX[0] = 50;  fruitY[0] = 115; fruitD[0] = 15;

  fruitX[1] = 250; fruitY[1] = 115; fruitD[1] = 15;

  fruitX[2] = 650; fruitY[2] = 115; fruitD[2] = 15;

  fruitX[3] = 680; fruitY[3] = 130; fruitD[3] = 15;



  // 별똥별(가속) 초기화

  for (let i = 0; i < 4; i++) {

    ssX[i] = random(0, width);

    ssY[i] = random(-200, 0);

    ssSpeedX[i] = 0;

    ssSpeedY[i] = 0;

    ssAccelX[i] = random(0.05, 0.1);

    ssAccelY[i] = random(0.1, 0.2);

  }



  // 별똥별(마찰) 초기화

  for (let i = 0; i < 4; i++) {

    fsX[i] = random(0, width);

    fsY[i] = random(-200, 0);

    fsSpeedX[i] = random(2, 10);

    fsSpeedY[i] = random(5, 15);

    fsFriction[i] = 0.97;

  }

}



function draw() {

  background(135, 206, 235);



  // 별똥별(가속) 그리기

  for (let i = 0; i < ssX.length; i++) {

    ssSpeedX[i] += ssAccelX[i];

    ssSpeedY[i] += ssAccelY[i];

    ssX[i] += ssSpeedX[i];

    ssY[i] += ssSpeedY[i];



    if (ssY[i] > height + 50 || ssX[i] > width + 50) {

      ssX[i] = random(0, width);

      ssY[i] = random(-200, 0);

      ssSpeedX[i] = 0;

      ssSpeedY[i] = 0;

    }



    noStroke();

    fill(255, 255, 150);

    ellipse(ssX[i], ssY[i], 6, 6);

  }



  // 별똥별(마찰) 그리기

  for (let i = 0; i < fsX.length; i++) {

    fsSpeedX[i] *= fsFriction[i];

    fsSpeedY[i] *= fsFriction[i];

    fsX[i] += fsSpeedX[i];

    fsY[i] += fsSpeedY[i];



    if (fsSpeedY[i] < 0.2 || fsY[i] > height + 50 || fsX[i] > width + 50) {

      fsX[i] = random(0, width);

      fsY[i] = random(-200, 0);

      fsSpeedX[i] = random(2, 10);

      fsSpeedY[i] = random(5, 15);

    }



    noStroke();

    fill(255, 200, 200);

    ellipse(fsX[i], fsY[i], 6, 6);

  }



  // 바닥 그리기

  drawGround();



  // 나무 그리기

  for (let i = 0; i < treeX.length; i++) {

    drawTree(treeX[i], treeY[i], treeType[i]);

  }



  // 열매 그리기

  for (let i = 0; i < fruitX.length; i++) {

    drawFruit(fruitX[i], fruitY[i], fruitD[i]);

  }



  // 사람 이동 (A, D 키)

  if (keyIsPressed) { 

    if (key === 'a' || key === 'A') {

      personX--; 

    } else if (key === 'd' || key === 'D') {

      personX++; 

    }

  }



  // 사람, 바위 그리기

  drawPerson();

  drawRock();



  // 태양 그리기 및 업데이트

  sunX += sunVelocity;

  if (sunX < 0 || sunX > 1000) {

    sunX = 1000;

  }

  noStroke();

  fill(255, 255, 0);

  ellipse(sunX, sunY, sunSize, sunSize);



  // 쥐 그리기 및 업데이트

  ratX += ratSpeed;

  if (ratX < 0 || ratX > 1000) {

    ratX = 0;

  }

  drawRat(ratX, ratY);



  // 날파리 그리기

  let flyY = 200 + 30 * sin(flyTheta);

  flyTheta += 0.2;



  flyX += 3;

  if (flyX > width) {

    flyX = 0;

  }



  stroke(0);

  strokeWeight(5);

  point(flyX, flyY);

}





// 그리기 함수들



function drawGround() {

  noStroke();

  if (key === "g") {

    groundR = 50; groundG = 205; groundB = 50;

  } else if (key === "m") {

    groundR = 245; groundG = 222; groundB = 179;

  }

  fill(groundR, groundG, groundB);

  rect(groundX, groundY, groundW, groundH);

}



function drawTree(x, y, type) {

  noStroke();

  fill(139, 69, 19); 

  rect(x, y, 30, 120);



  let leafX = x + 15;

  

  if (type === 0) { 

    fill(0, 255, 0);

    ellipse(leafX, y, 80, 80);

  } else if (type === 1) { 

    let dd = dist(leafX, y, mouseX, mouseY);

    fill(130, dd, 0);

    ellipse(leafX, y, 80, 80);

  } else if (type === 2) { 

    let radius = 40;

    let d = dist(leafX, y, mouseX, mouseY);

    if (d < radius) {

      fill(194, 30, 39);

    } else {

      fill(0, 255, 0);

    }

    ellipse(leafX, y, radius * 2, radius * 2);

  }

}



function drawFruit(x, y, d) {

  noStroke();

  if (x === 50) {

    let distance = dist(x, y, mouseX, mouseY);

    if (distance < d / 2) {

      fill(0, 255, 0);

    } else {

      fill(255, 0, 0);

    }

  } else {

    fill(255, 0, 0);

  }

  ellipse(x, y, d, d);

}



function drawPerson() {

  stroke(0);

  strokeWeight(1);

  

  fill(0, 0, 255);

  beginShape();

  vertex(90 + personX, 190); vertex(90 + personX, 240); vertex(100 + personX, 240); vertex(100 + personX, 200);

  vertex(100 + personX, 270); vertex(110 + personX, 270); vertex(110 + personX, 240); vertex(110 + personX, 270);

  vertex(120 + personX, 270); vertex(120 + personX, 240); vertex(120 + personX, 200); vertex(120 + personX, 240);

  vertex(130 + personX, 240); vertex(130 + personX, 190); vertex(90 + personX, 190);

  endShape();



  fill(222, 184, 135);

  ellipse(110 + personX, 175, 30, 30);



  strokeWeight(3);

  point(115 + personX, 170);

  point(105 + personX, 170);

  

  strokeWeight(1);

  line(108 + personX, 180, 113 + personX, 180);



  fill(210, 105, 30);

  beginShape();

  vertex(130 + personX, 165); vertex(90 + personX, 165); vertex(110 + personX, 150);

  endShape(CLOSE);

}



function drawRock() {

  noStroke();

  fill(127);

  arc(rockX, rockY, rockSize, rockSize, radians(180), radians(0));

}



function drawRat(x, y) {

  noStroke();

  fill(127);

  ellipse(x, y, 16, 16);



  beginShape();

  vertex(x, y + 8);

  vertex(x, y - 8);

  vertex(x + 20, y);

  endShape(CLOSE);



  fill(0);

  ellipse(x + 10, y - 4, 4, 4);

} 
